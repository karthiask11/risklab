rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email == 'stockanalysistamil@gmail.com' && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function blockedUser() { return exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function writer(uid) { return owner(uid) && !blockedUser(); }
    function okName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 80; }

    // Site settings: everyone reads (banner, which features need sign-in); only admins change them.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Blocked accounts: the admin blocks; the user may read their own entry (to see the message).
    match /blocked/{uid} {
      allow read: if isAdmin() || owner(uid);
      allow write: if isAdmin();
    }
    // Activity from the customer site: a signed-in user can only add their own events; only admins read or delete.
    match /activity/{id} {
      allow create: if signedIn() && !blockedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'type', 'detail', 'at'])
        && request.resource.data.type in ['signin', 'view', 'stocks', 'save_plan', 'save_report']
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }
    // Admin User IDs: anyone may look up one exact ID (to sign in); only admins list or change them; each admin sets their own.
    match /adminLogin/{id} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() && id.matches('^[a-z0-9._-]{3,30}$')
        && request.resource.data.keys().hasOnly(['email', 'uid', 'updated'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'uid', 'updated'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
    }
    // Admin list.
    match /admins/{uid} {
      allow read: if isAdmin() || owner(uid);
      allow write: if isAdmin();
    }
    // A user's profile and saved work: the user, and admins may read.
    match /users/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow delete: if owner(uid) || isAdmin();
      allow create, update: if writer(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'created', 'lastLogin'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;

      match /portfolios/{pid} {
        allow read: if owner(uid) || isAdmin();
        allow delete: if owner(uid) || isAdmin();
        allow create, update: if writer(uid)
          && request.resource.data.keys().hasOnly(['name', 'holdings', 'mode', 'period', 'tx', 'ips', 'created', 'updated'])
          && okName(request.resource.data)
          && request.resource.data.holdings is list
          && request.resource.data.holdings.size() <= 100
          && (!('tx' in request.resource.data) || (request.resource.data.tx is list && request.resource.data.tx.size() <= 1000))
          && (!('ips' in request.resource.data) || request.resource.data.ips is map);
      }
      match /plans/{id} {
        allow read: if owner(uid) || isAdmin();
        allow delete: if owner(uid) || isAdmin();
        allow create, update: if writer(uid)
          && request.resource.data.keys().hasOnly(['name', 'ips', 'created', 'updated'])
          && okName(request.resource.data) && request.resource.data.ips is map;
      }
      match /reports/{id} {
        allow read: if owner(uid) || isAdmin();
        allow delete: if owner(uid) || isAdmin();
        allow create: if writer(uid)
          && request.resource.data.keys().hasOnly(['name', 'kind', 'data', 'created'])
          && okName(request.resource.data)
          && request.resource.data.kind in ['portfolio', 'perf']
          && request.resource.data.data is map && request.resource.data.data.size() <= 30;
      }
    }
    // Admin pages read across all users (collection group queries).
    match /{path=**}/portfolios/{pid} { allow read: if isAdmin(); }
    match /{path=**}/plans/{id} { allow read: if isAdmin(); }
    match /{path=**}/reports/{id} { allow read: if isAdmin(); }
  }
}
